---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hud from '../components/hud/Hud.astro';
import { useTranslations } from '../i18n/utils';

// One static 404 for both languages (hosts serve /404.html for any miss): French first, English below.
const fr = useTranslations('fr');
const en = useTranslations('en');
---

<BaseLayout title={`404 · ${fr('notfound.title')}`} noindex>
  <Hud lang="fr" />
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-4 pt-28 pb-16 outline-none"
  >
    <p class="font-mono text-sm text-signal" aria-hidden="true">
      ERR · 404 · ∅
    </p>
    <h1 class="mt-4 font-display text-5xl leading-none font-extrabold tracking-tight sm:text-7xl">
      {fr('notfound.title')}
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted">{fr('notfound.body')}</p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex rounded-md bg-plasma px-5 py-3 font-mono text-sm font-bold text-bg hover:bg-ink"
      >
        {fr('notfound.home')}
      </a>
    </p>
    <section lang="en" aria-labelledby="notfound-en" class="mt-16 border-t border-line pt-8">
      <h2 id="notfound-en" class="font-display text-2xl font-bold">
        {en('notfound.title')}
      </h2>
      <p class="mt-3 text-muted">{en('notfound.body')}</p>
      <p class="mt-4">
        <a href="/en/" class="font-mono text-sm text-signal underline underline-offset-4">
          {en('notfound.home')}
        </a>
      </p>
    </section>
  </main>
</BaseLayout>
