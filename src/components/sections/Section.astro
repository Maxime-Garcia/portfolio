---
import type { Lang, SectionId } from '../../i18n/ui';
import { sections } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  id: Exclude<SectionId, 'hero'>;
  lang: Lang;
}

const { id, lang } = Astro.props;
const t = useTranslations(lang);
const index = String(sections.indexOf(id) + 1).padStart(2, '0');
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class="mx-auto flex min-h-[80dvh] max-w-6xl flex-col justify-center px-4 py-24"
>
  <p class="font-mono text-sm text-signal" aria-hidden="true">
    {index} / 06
  </p>
  <h2 id={`${id}-title`} class="mt-2 font-display text-3xl font-bold sm:text-5xl">
    {t(`section.${id}`)}
  </h2>
  <slot>
    <p class="mt-4 text-muted">{t('section.soon')}</p>
  </slot>
</section>
