---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { skillGroups } from '../../lib/skills';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="skills" lang={lang} lead="skills.lead">
  <div class="grid gap-6 md:grid-cols-3">
    {skillGroups.map((group) => (
      <div class="rounded-xl border border-line bg-surface/60 p-6">
        <h3 class="font-mono text-sm tracking-wide text-signal uppercase">{t(group.label)}</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <li class="rounded-md border border-line px-3 py-1.5 text-ink">{skill}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
