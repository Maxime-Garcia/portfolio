---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { skillGroups } from '../../lib/skills';
import SkillIcon from '../skills/SkillIcon.astro';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
/** Bento spans on the 12-column cargo grid (large screens). */
const spans: Record<string, string> = {
  connect: 'lg:col-span-7',
  code: 'lg:col-span-5',
  ship: 'lg:col-span-7',
  invent: 'lg:col-span-5',
  understand: 'lg:col-span-12',
};
---

<Section id="skills" lang={lang} lead="skills.lead">
  <div class="grid gap-5 lg:grid-cols-12">
    {skillGroups.map((group, i) => (
      <section class:list={['crate', spans[group.id]]} aria-labelledby={`crate-${group.id}`}>
        <h3
          id={`crate-${group.id}`}
          class="flex items-baseline justify-between gap-3 font-mono text-sm tracking-wide uppercase"
        >
          <span class="text-signal">{t(group.label)}</span>
          <span class="text-xs text-muted" aria-hidden="true">
            {t('skills.crate')} {String(i + 1).padStart(2, '0')} · {group.skills.length}
          </span>
        </h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <li class="skill-chip">
              <SkillIcon icon={skill.icon} />
              <span>{typeof skill.name === 'string' ? skill.name : t(skill.name.key)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Section>
