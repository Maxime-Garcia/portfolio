---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { SITE } from '../../lib/site';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// TODO(maxime): set PUBLIC_FORMSPREE_ID (Vercel env + GitHub secret) to enable the form.
const formId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const enabled = Boolean(formId);
const action = enabled ? `https://formspree.io/f/${formId}` : undefined;
const field =
  'mt-2 w-full rounded-md border border-line bg-bg px-3 py-2 text-ink placeholder:text-muted disabled:opacity-60';
---

<Section id="contact" lang={lang} lead="contact.lead">
  <div class="grid gap-12 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <form
      method="POST"
      action={action}
      data-contact-form
      data-sending={t('contact.sending')}
      data-success={t('contact.success')}
      data-error={t('contact.error')}
      class="rounded-xl border border-line bg-surface/90 p-6"
    >
      {!enabled && (
        <p id="contact-disabled" class="mb-6 rounded-md border border-amp p-3 text-ink">
          {t('contact.disabled')}
        </p>
      )}
      <fieldset
        disabled={!enabled}
        aria-describedby={enabled ? undefined : 'contact-disabled'}
        class="grid gap-5"
      >
        <label class="block font-mono text-sm text-ink">
          {t('contact.name')}
          <input name="name" type="text" autocomplete="name" required class={field} />
        </label>
        <label class="block font-mono text-sm text-ink">
          {t('contact.email')}
          <input name="email" type="email" autocomplete="email" required class={field} />
        </label>
        <label class="block font-mono text-sm text-ink">
          {t('contact.message')}
          <textarea name="message" rows="5" required class={field}></textarea>
        </label>
        <!-- Honeypot: humans never see or fill it. -->
        <div class="hidden" aria-hidden="true">
          <input name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="_language" value={lang} />
        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="rounded-md bg-plasma px-5 py-3 font-mono text-sm font-bold text-bg transition-colors hover:bg-ink disabled:cursor-not-allowed motion-reduce:transition-none"
          >
            {t('contact.submit')}
          </button>
          <p data-contact-status role="status" aria-live="polite" class="text-muted"></p>
        </div>
      </fieldset>
    </form>

    <div class="self-start rounded-xl border border-line bg-surface/90 p-6">
      <h3 class="font-mono text-sm tracking-wide text-signal uppercase">{t('contact.links')}</h3>
      <ul class="mt-4 grid gap-3">
        <li>
          <a
            href={SITE.github}
            rel="me"
            class="text-ink underline decoration-signal underline-offset-4 hover:text-signal"
          >
            GitHub · Maxime-Garcia
          </a>
        </li>
        <!-- TODO(maxime): LinkedIn URL. -->
        <li class="text-muted">{t('contact.linkedin.soon')}</li>
      </ul>
    </div>
  </div>
</Section>

<script>
  import { initContactForm } from '../../scripts/contact';

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
