---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Badge from '../ui/Badge.astro';
import Section from './Section.astro';
import StarFragment from '../ui/StarFragment.astro';
import GameArt from '../passions/GameArt.astro';
import musicData from '../../content/music.json';
import { musicSchema } from '../../lib/music';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// TODO(maxime): run `node scripts/music-takeout.ts <watch-history>` to fill this from YouTube Music.
const music = musicSchema.parse(musicData);
const worlds = [
  { id: 'outerwilds', name: 'Outer Wilds' },
  { id: 'dofus', name: 'Dofus' },
  { id: 'tunic', name: 'Tunic' },
] as const;
---

<Section id="passions" lang={lang} lead="passions.lead">
  <div class="grid gap-6 md:grid-cols-2">
    <article class="rounded-xl border border-line bg-surface/90 p-6">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-display text-xl font-bold">{t('passions.music.title')}</h3>
        {music.placeholder && <Badge>{t('placeholder.badge')}</Badge>}
      </div>
      <p class="mt-3 text-muted">{t('passions.music.body')}</p>
      <h4 class="mt-6 font-mono text-sm text-ink">{t('passions.music.genres')}</h4>
      <ul class="mt-3 flex flex-wrap items-baseline gap-2">
        {music.genres.map((genre) => (
          <li
            class="rounded-full border border-plasma px-3 py-1 font-mono text-plasma"
            style={`font-size: ${(0.75 + genre.weight * 0.4).toFixed(2)}rem`}
          >
            {genre.name}
          </li>
        ))}
      </ul>
      <h4 class="mt-6 font-mono text-sm text-ink">{t('passions.music.artists')}</h4>
      <ul class="mt-3 flex flex-wrap gap-2">
        {music.artists.map((artist) => (
          <li>
            <a
              href={artist.url}
              rel="noopener"
              target="_blank"
              class="inline-flex items-center gap-1.5 rounded-full border border-line bg-bg/60 px-3 py-1.5 text-sm text-ink transition-colors hover:border-signal hover:text-signal motion-reduce:transition-none"
            >
              <span aria-hidden="true" class="text-signal">
                ♪
              </span>
              {artist.name}
              <span class="sr-only">{t('passions.music.newtab')}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 font-mono text-xs text-muted">
        {t('passions.music.source')} · {music.generatedAt}
      </p>
    </article>
    <article class="rounded-xl border border-line bg-surface/90 p-6">
      <h3 class="flex items-center gap-1 font-display text-xl font-bold">
        {t('passions.games.title')}
        <StarFragment id="passions" lang={lang} />
      </h3>
      <p class="mt-3 text-muted">{t('passions.games.body')}</p>
      <ul class="mt-6 grid gap-4">
        {worlds.map((world) => (
          <li class="grid grid-cols-[6rem_1fr] items-center gap-4">
            <div class="aspect-[16/10] overflow-hidden rounded-lg border border-line">
              <GameArt kind={world.id} />
            </div>
            <div>
              <p class="font-display font-bold text-ink">{world.name}</p>
              <p class="mt-1 text-sm text-muted">{t(`games.${world.id}`)}</p>
            </div>
          </li>
        ))}
      </ul>
    </article>
  </div>

  <article
    id="arcade"
    aria-labelledby="arcade-title"
    class="mt-6 rounded-xl border border-plasma bg-surface/90 p-6"
    data-js-only
  >
    <h3 id="arcade-title" class="font-display text-xl font-bold">
      {t('arcade.title')}
    </h3>
    <p class="mt-2 text-muted">{t('arcade.lead')}</p>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      <li class="flex flex-col gap-3 rounded-lg border border-line bg-bg/60 p-4">
        <p class="flex-1 text-sm text-ink">{t('arcade.gravity')}</p>
        <button type="button" data-game-open class="arcade-button">
          ▶ {t('game.play')}
        </button>
      </li>
      <li class="flex flex-col gap-3 rounded-lg border border-line bg-bg/60 p-4">
        <p class="flex-1 text-sm text-ink">{t('arcade.fragments')}</p>
        <p class="font-mono text-sm text-signal">
          <span aria-hidden="true">✦</span>
          <span class="sr-only">{t('hud.fragments')} :</span>
          <span data-fragments-progress>0/6</span>
        </p>
      </li>
      <li class="flex flex-col gap-3 rounded-lg border border-line bg-bg/60 p-4">
        <p class="flex-1 text-sm text-ink">{t('arcade.terminal')}</p>
        <button type="button" data-terminal-open class="arcade-button">
          ›_ {t('arcade.open.terminal')}
        </button>
      </li>
    </ul>
  </article>
</Section>
