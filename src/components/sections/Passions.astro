---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Section from './Section.astro';
import StarFragment from '../ui/StarFragment.astro';
import GameArt from '../passions/GameArt.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import gameCredits from '../../assets/games/credits.json';
import MusicRadio from '../passions/MusicRadio.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Official visuals, when Maxime adds them to src/assets/games/ (see the README there).
const gameImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/games/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const imageFor = (id: string) =>
  Object.entries(gameImages).find(([path]) => path.split('/').pop()?.split('.')[0] === id)?.[1]
    .default;
const creditFor = (id: string) => (gameCredits as Record<string, string>)[id];
const worlds = [
  { id: 'outerwilds', name: 'Outer Wilds' },
  { id: 'dofus', name: 'Dofus' },
  { id: 'tunic', name: 'Tunic' },
] as const;
---

<Section id="passions" lang={lang} lead="passions.lead">
  <div class="grid gap-6 md:grid-cols-2">
    <MusicRadio lang={lang} />
    <article class="rounded-xl border border-line bg-surface/90 p-6">
      <h3 class="flex items-center gap-1 font-display text-xl font-bold">
        {t('passions.games.title')}
        <StarFragment id="passions" lang={lang} />
      </h3>
      <p class="mt-3 text-muted">{t('passions.games.body')}</p>
      <ul class="mt-6 grid gap-4">
        {worlds.map((world) => (
          <li class="grid grid-cols-[6rem_1fr] items-center gap-4">
            <div class="aspect-[16/10] overflow-hidden rounded-lg border border-line">
              {imageFor(world.id) ? (
                <Image
                  src={imageFor(world.id) as ImageMetadata}
                  alt=""
                  widths={[192, 384]}
                  sizes="6rem"
                  class="h-full w-full object-cover"
                />
              ) : (
                <GameArt kind={world.id} />
              )}
            </div>
            <div>
              <p class="font-display font-bold text-ink">{world.name}</p>
              <p class="mt-1 text-sm text-muted">{t(`games.${world.id}`)}</p>
              {creditFor(world.id) && (
                <p class="mt-1 font-mono text-[0.65rem] text-muted">{creditFor(world.id)}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </article>
  </div>

  <article
    id="arcade"
    aria-labelledby="arcade-title"
    class="mt-6 rounded-xl border border-plasma bg-surface/90 p-6"
    data-js-only
  >
    <h3 id="arcade-title" class="font-display text-xl font-bold">
      {t('arcade.title')}
    </h3>
    <p class="mt-2 text-muted">{t('arcade.lead')}</p>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      <li class="flex flex-col gap-3 rounded-lg border border-line bg-bg/60 p-4">
        <p class="flex-1 text-sm text-ink">{t('arcade.gravity')}</p>
        <button type="button" data-game-open class="arcade-button">
          ▶ {t('game.play')}
        </button>
      </li>
      <li class="flex flex-col gap-3 rounded-lg border border-line bg-bg/60 p-4">
        <p class="flex-1 text-sm text-ink">{t('arcade.fragments')}</p>
        <p class="font-mono text-sm text-signal">
          <span aria-hidden="true">✦</span>
          <span class="sr-only">{t('hud.fragments')} :</span>
          <span data-fragments-progress>0/6</span>
        </p>
      </li>
      <li class="flex flex-col gap-3 rounded-lg border border-line bg-bg/60 p-4">
        <p class="flex-1 text-sm text-ink">{t('arcade.terminal')}</p>
        <button type="button" data-terminal-open class="arcade-button">
          ›_ {t('arcade.open.terminal')}
        </button>
      </li>
    </ul>
  </article>
</Section>
