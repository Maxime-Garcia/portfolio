---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Badge from '../ui/Badge.astro';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// TODO(maxime): replace with real recordings (and keep preload="none").
const track = '/audio/placeholder-guitare.wav';
// TODO(maxime): the games that shaped you.
const games = [1, 2, 3];
---

<Section id="passions" lang={lang} lead="passions.lead">
  <div class="grid gap-6 md:grid-cols-2">
    <article class="rounded-xl border border-line bg-surface/90 p-6">
      <h3 class="font-display text-xl font-bold">{t('passions.music.title')}</h3>
      <p class="mt-3 text-muted">{t('passions.music.body')}</p>
      <figure class="mt-6">
        <figcaption class="flex flex-wrap items-center gap-2 font-mono text-sm text-ink">
          {t('passions.music.track')}
          <Badge>{t('placeholder.badge')}</Badge>
        </figcaption>
        <audio controls preload="none" src={track} class="mt-3 w-full" data-passions-audio>
          <a href={track} download>
            {t('passions.music.download')}
          </a>
          {t('passions.music.fallback')}
        </audio>
      </figure>
    </article>
    <article class="rounded-xl border border-line bg-surface/90 p-6">
      <h3 class="font-display text-xl font-bold">{t('passions.games.title')}</h3>
      <p class="mt-3 text-muted">{t('passions.games.body')}</p>
      <h4 class="mt-6 font-mono text-sm text-ink">{t('passions.games.list')}</h4>
      <ul class="mt-3 grid grid-cols-3 gap-3">
        {games.map((n) => (
          <li class="flex aspect-[3/4] flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-line p-2 text-center">
            <span class="font-display text-2xl text-muted" aria-hidden="true">
              ?
            </span>
            <span class="font-mono text-xs text-muted">
              {t('placeholder.todo')} {n}
            </span>
          </li>
        ))}
      </ul>
    </article>
  </div>
</Section>
