---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hud from './hud/Hud.astro';
import Badge from './ui/Badge.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { fragmentIds } from '../lib/fragments';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// TODO(maxime): the games that shaped you, and your player story (journal.player.body).
const games = [1, 2, 3, 4];
---

<BaseLayout title={t('journal.title')} noindex>
  <Hud lang={lang} />
  <main
    id="main"
    tabindex="-1"
    class="mx-auto max-w-3xl px-4 pt-32 pb-24 outline-none"
    data-journal
  >
    <p class="font-mono text-sm text-signal" aria-hidden="true">
      ✦ ✦ ✦ ✦ ✦ ✦
    </p>
    <h1 class="mt-3 font-display text-4xl font-extrabold sm:text-6xl">{t('journal.title')}</h1>

    <p
      data-journal-locked
      hidden
      class="mt-8 rounded-xl border border-amp bg-surface/90 p-6 text-lg text-ink"
    >
      {t('journal.locked')}
    </p>

    <div data-journal-content>
      <p class="mt-6 text-lg text-muted">{t('journal.lead')}</p>
      <ul class="mt-6 flex flex-wrap gap-2 font-mono text-sm">
        {fragmentIds.map((id) => (
          <li class="rounded-full border border-signal px-3 py-1 text-signal">
            ✦ {t(`body.${id}`)}
          </li>
        ))}
      </ul>

      <section
        class="mt-12 rounded-xl border border-line bg-surface/90 p-6"
        aria-labelledby="journal-player"
      >
        <div class="flex flex-wrap items-center gap-2">
          <h2 id="journal-player" class="font-display text-2xl font-bold">
            {t('journal.player')}
          </h2>
          <Badge>{t('placeholder.todo')}</Badge>
        </div>
        <p class="mt-3 text-muted">{t('journal.player.body')}</p>
        <h3 class="mt-6 font-mono text-sm text-ink">{t('journal.games')}</h3>
        <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {games.map((n) => (
            <li class="flex aspect-[3/4] flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-line p-2 text-center">
              <span class="font-display text-2xl text-muted" aria-hidden="true">
                ?
              </span>
              <span class="font-mono text-xs text-muted">
                {t('placeholder.todo')} {n}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section
        class="mt-8 rounded-xl border border-line bg-surface/90 p-6"
        aria-labelledby="journal-gravity"
      >
        <h2 id="journal-gravity" class="font-display text-2xl font-bold">
          {t('journal.gravity')}
        </h2>
        <ol
          data-gravity-records
          class="mt-4 grid gap-2 font-mono text-sm"
          data-none={t('journal.gravity.none')}
        ></ol>
      </section>
    </div>
  </main>
  <!-- Lock state applied before first paint (no layout shift); the module below keeps it in sync. -->
  <script is:inline>
    (() => {
      let count = 0;
      try {
        count = JSON.parse(localStorage.getItem('orbite:fragments') || '[]').length;
      } catch {
        /* storage blocked: stays locked */
      }
      const complete = count >= 6;
      const locked = document.querySelector('[data-journal-locked]');
      const content = document.querySelector('[data-journal-content]');
      if (locked) locked.hidden = complete;
      if (content) content.hidden = !complete;
    })();
  </script>
</BaseLayout>

<script>
  import { fragments } from '../stores/fragments';
  import { parseBest, starsFor } from '../game/gravity/engine';

  function render() {
    const root = document.querySelector<HTMLElement>('[data-journal]');
    if (!root) return;
    const complete = fragments.get().length === 6;
    const locked = root.querySelector<HTMLElement>('[data-journal-locked]');
    const content = root.querySelector<HTMLElement>('[data-journal-content]');
    if (locked) locked.hidden = complete;
    if (content) content.hidden = !complete;

    const list = root.querySelector<HTMLElement>('[data-gravity-records]');
    if (!list) return;
    let best: Record<number, number> = {};
    try {
      best = parseBest(localStorage.getItem('orbite:gravity'));
    } catch {
      /* storage blocked */
    }
    const entries = Object.entries(best);
    list.replaceChildren(
      ...(entries.length
        ? entries.map(([level, attempts]) => {
            const item = document.createElement('li');
            const stars = starsFor(attempts);
            item.textContent = `#${level} · ${'★'.repeat(stars)}${'☆'.repeat(3 - stars)} · ${attempts}`;
            return item;
          })
        : [Object.assign(document.createElement('li'), { textContent: list.dataset.none ?? '' })]),
    );
  }

  render();
  document.addEventListener('astro:page-load', render);
</script>
