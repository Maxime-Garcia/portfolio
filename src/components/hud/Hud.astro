---
import type { Lang } from '../../i18n/ui';
import { sections } from '../../i18n/ui';
import { localizePath, otherLang, useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const target = otherLang(lang);
const switchHref = localizePath(target, Astro.url.pathname);
// Absolute anchors so the map also works from project pages.
const home = localizePath(lang, '/');
const control =
  'inline-flex min-h-8 min-w-8 items-center justify-center rounded-md border border-line px-2 py-1 text-muted transition-colors hover:text-ink motion-reduce:transition-none';
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-bg/85 font-mono text-sm backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <a href={`${home}#hero`} class="font-display text-base font-bold tracking-tight text-ink">
      MG
      <span class="text-plasma" aria-hidden="true">
        ·
      </span>
      <span class="sr-only">{t('hud.home')}</span>
    </a>

    <nav
      aria-label={t('hud.label')}
      class="order-last w-full overflow-x-auto md:order-none md:w-auto"
    >
      <ol class="flex gap-1">
        {sections.map((id, index) => (
          <li>
            <a
              href={`${home}#${id}`}
              data-hud-section={id}
              class="block rounded-md px-2 py-1 whitespace-nowrap text-muted transition-colors hover:text-ink aria-[current]:bg-surface aria-[current]:text-ink motion-reduce:transition-none"
            >
              <span class="text-signal" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>{' '}
              {t(`section.${id}`)}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-ignite
        title={t('hud.ignite')}
        class={`${control} items-center gap-1 text-signal hover:border-signal`}
      >
        <span aria-hidden="true">▲</span>
        <span class="sr-only xl:not-sr-only">{t('hud.ignite')}</span>
      </button>
      <p class="hidden items-center gap-1 px-1 text-muted sm:flex" data-js-only>
        <span aria-hidden="true" class="text-amp">
          ★
        </span>
        <span class="sr-only">{t('hud.achievements')} :</span>
        <span data-achievements-progress>0/6</span>
      </p>
      <button
        type="button"
        data-terminal-open
        data-js-only
        title={`${t('hud.terminal')} (Ctrl+K)`}
        aria-keyshortcuts="Control+K Meta+K"
        class={control}
      >
        <span aria-hidden="true" class="text-signal">
          ›_
        </span>
        <span class="sr-only">{t('hud.terminal')}</span>
      </button>
      <button
        type="button"
        data-sound-toggle
        data-js-only
        title={t('hud.sound')}
        aria-pressed="false"
        class={`${control} aria-pressed:border-signal aria-pressed:text-signal`}
      >
        <span aria-hidden="true">♪</span>
        <span class="sr-only">{t('hud.sound')}</span>
      </button>
      <button
        type="button"
        data-theme-toggle
        title={t('hud.theme')}
        aria-pressed="false"
        hidden
        class={`${control} aria-pressed:border-amp aria-pressed:text-amp`}
      >
        <span aria-hidden="true">◐</span>
        <span class="sr-only">{t('hud.theme')}</span>
      </button>
      <a
        href={switchHref}
        data-lang-switch
        hreflang={target}
        lang={target}
        title={t('hud.lang.label')}
        class={control}
      >
        <span aria-hidden="true">{target.toUpperCase()}</span>
        <span class="sr-only">{t('hud.lang.label')}</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { initThemeToggle } from '../../scripts/theme';

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);

  // "Ignite the engines": explicit way to load the 3D scene (see client:intent).
  document.addEventListener('click', (event) => {
    if ((event.target as Element | null)?.closest('[data-ignite]')) {
      window.dispatchEvent(new Event('orbite:ignite'));
    }
  });
</script>
