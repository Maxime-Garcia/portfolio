---
import musicData from '../../content/music.json';
import { musicSchema } from '../../lib/music';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Badge from '../ui/Badge.astro';
import Cover from './Cover.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// TODO(maxime): run `node scripts/music-takeout.ts <watch-history>` to tune in to your real listening.
const music = musicSchema.parse(musicData);
const latest = music.latest;
const played = latest ? new Date(latest.playedAt) : undefined;
const playedLabel = played?.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  day: 'numeric',
  month: 'long',
});
---

<article
  class="radio flex flex-col rounded-xl border border-line bg-surface/90 p-6"
  aria-labelledby="radio-title"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <h3 id="radio-title" class="font-display text-xl font-bold">
        {t('passions.music.title')}
      </h3>
      {music.placeholder && <Badge>{t('placeholder.badge')}</Badge>}
    </div>
    <p class="flex items-center gap-2 font-mono text-xs text-muted">
      <span class="radio-led" aria-hidden="true"></span>
      {t('radio.frequency')}
    </p>
  </div>
  <p class="mt-3 text-muted">{t('passions.music.body')}</p>

  {latest && (
    <a
      href={latest.url}
      rel="noopener"
      target="_blank"
      class="radio-latest mt-6 grid grid-cols-[4.5rem_1fr] items-center gap-4 rounded-lg border border-line bg-bg/60 p-3 transition-colors hover:border-signal motion-reduce:transition-none"
    >
      <Cover src={latest.cover} seed={0} class="aspect-square w-18 rounded-md" />
      <span class="min-w-0">
        <span class="flex items-center justify-between gap-2 font-mono text-xs text-muted">
          {t('radio.latest')}
          {played && (
            <time datetime={latest.playedAt} data-relative class="shrink-0">
              {playedLabel}
            </time>
          )}
        </span>
        <span class="mt-1 block truncate font-bold text-ink">{latest.title}</span>
        <span class="block truncate text-sm text-muted">{latest.artist}</span>
        <svg
          viewBox="0 0 200 20"
          class="radio-wave mt-2 h-4 w-full"
          aria-hidden="true"
          preserveAspectRatio="none"
        >
          <path d="M0 10 Q 10 2 20 10 T 40 10 T 60 10 T 80 10 T 100 10 T 120 10 T 140 10 T 160 10 T 180 10 T 200 10" />
        </svg>
        <span class="sr-only">{t('passions.music.newtab')}</span>
      </span>
    </a>
  )}

  {music.tracks.length > 0 && (
    <>
      <h4 class="mt-6 font-mono text-sm text-ink">{t('radio.rotation')}</h4>
      <ul class="mt-3 grid grid-cols-3 gap-3">
        {music.tracks.map((track, i) => (
          <li>
            <a href={track.url} rel="noopener" target="_blank" class="radio-cover group block">
              <Cover src={track.cover} seed={i + 1} class="aspect-square w-full rounded-lg" />
              <span class="mt-1.5 block truncate text-xs text-ink">{track.title}</span>
              <span class="block truncate text-xs text-muted">{track.artist}</span>
              <span class="sr-only">{t('passions.music.newtab')}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <h4 class="mt-6 font-mono text-sm text-ink">{t('passions.music.genres')}</h4>
  <ul class="mt-3 flex flex-wrap gap-2">
    {music.genres.map((genre) => (
      <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-plasma">
        {genre.name}
      </li>
    ))}
  </ul>
  <p class="mt-6 font-mono text-xs text-muted">
    {t('passions.music.source')} · {music.generatedAt}
  </p>
</article>

<script>
  // "il y a 3 jours" / "3 days ago", in the page language, from the published date.
  function relative() {
    const lang = document.documentElement.lang || 'fr';
    const format = new Intl.RelativeTimeFormat(lang, { numeric: 'auto' });
    for (const time of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
      const seconds = (new Date(time.dateTime).getTime() - Date.now()) / 1000;
      const units: [Intl.RelativeTimeFormatUnit, number][] = [
        ['year', 31536000],
        ['month', 2592000],
        ['week', 604800],
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
      ];
      const [unit, size] = units.find(([, s]) => Math.abs(seconds) >= s) ?? ['minute', 60];
      time.textContent = format.format(Math.round(seconds / size), unit);
    }
  }
  relative();
  document.addEventListener('astro:page-load', relative);
</script>
