---
interface Props {
  src?: string;
  seed: number;
  class?: string;
}

// A real album cover when the Takeout script fetched one, otherwise a generated "record" disc.
const { src, seed, class: className } = Astro.props;
const tones = ['var(--plasma)', 'var(--signal)', 'var(--amp)'];
const a = tones[seed % 3];
const b = tones[(seed + 1) % 3];
const id = `cover-${seed}`;
---

{src ? (
  <img
    src={src}
    alt=""
    width="320"
    height="320"
    loading="lazy"
    decoding="async"
    class:list={['object-cover', className]}
  />
) : (
  <svg viewBox="0 0 100 100" aria-hidden="true" class={className}>
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={a} />
        <stop offset="100%" stop-color={b} />
      </linearGradient>
    </defs>
    <rect width="100" height="100" fill={`url(#${id})`} />
    <circle cx="50" cy="50" r="34" fill="var(--bg)" opacity="0.85" />
    <circle cx="50" cy="50" r="26" fill="none" stroke={a} stroke-opacity="0.35" />
    <circle cx="50" cy="50" r="18" fill="none" stroke={b} stroke-opacity="0.35" />
    <circle cx="50" cy="50" r="6" fill={a} />
  </svg>
)}
