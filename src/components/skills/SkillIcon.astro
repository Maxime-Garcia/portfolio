---
import * as icons from 'simple-icons';
import type { SkillIcon } from '../../lib/skills';

interface Props {
  icon: SkillIcon;
}

const { icon } = Astro.props;

/** Original pictograms for generic skills (24×24, stroke = currentColor). */
const glyphs: Record<string, string> = {
  weave: 'M3 7h6c3 0 3 10 6 10h6M3 17h6c3 0 3-10 6-10h6',
  database:
    'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  loop: 'M7 7h8a5 5 0 0 1 0 10h-1M17 17H9a5 5 0 0 1 0-10h1M13 4l-3 3 3 3M11 20l3-3-3-3',
  dice: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zM8.5 8.5h.01M15.5 15.5h.01M12 12h.01M15.5 8.5h.01M8.5 15.5h.01',
  map: 'M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14',
  pad: 'M7 8h10a4 4 0 0 1 4 4v1a4 4 0 0 1-7 2.6h-4A4 4 0 0 1 3 13v-1a4 4 0 0 1 4-4zM8 10v4M6 12h4M15 11h.01M17 13h.01',
  lens: 'M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.3 15.3 20 20M7.5 12.5l2-2 1.5 1.5 2.5-3',
};
const brand =
  icon.kind === 'brand'
    ? (icons as Record<string, { path: string } | undefined>)[icon.id]
    : undefined;
---

{brand && (
  <svg viewBox="0 0 24 24" aria-hidden="true" class="skill-icon" fill="currentColor">
    <path d={brand.path} />
  </svg>
)}
{icon.kind === 'glyph' && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    class="skill-icon"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d={glyphs[icon.id]} />
  </svg>
)}
{icon.kind === 'mono' && (
  <span aria-hidden="true" class="skill-icon skill-mono">
    {icon.text}
  </span>
)}
