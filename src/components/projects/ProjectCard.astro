---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { parseProjectId, projectPath } from '../../lib/projects';
import Badge from '../ui/Badge.astro';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { slug } = parseProjectId(project.id);
const { title, summary, year, tags, stack, placeholder } = project.data;
---

<li data-project data-tags={tags.join(' ')} class="group">
  <article class="relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface/90 transition-colors group-hover:border-signal motion-reduce:transition-none">
    <ProjectCover slug={slug} tag={tags[0]} class="aspect-video w-full" />
    <div class="flex flex-1 flex-col p-6">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
        <span>{year}</span>
        {tags.map((tag) => (
          <span>· {t(`tag.${tag}`)}</span>
        ))}
        {placeholder && <Badge>{t('placeholder.badge')}</Badge>}
      </div>
      <h3 class="mt-3 font-display text-lg font-bold">
        <a href={projectPath(lang, slug)} class="after:absolute after:inset-0">
          {title}
        </a>
      </h3>
      <p class="mt-2 flex-1 text-muted">{summary}</p>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label={t('projects.stack')}>
        {stack.map((item) => (
          <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-ink">{item}</li>
        ))}
      </ul>
    </div>
  </article>
</li>
