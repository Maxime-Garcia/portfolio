---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SITE, pageTitle, personJsonLd } from '../lib/site';
import SpaceScene from '../components/space/SpaceScene';
import Terminal from '../components/terminal/Terminal';
import { getCollection } from 'astro:content';
import { parseProjectId, projectPath, sortProjects } from '../lib/projects';
import { alternates, getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type: the home pages are "profile", project pages "article". */
  type?: 'profile' | 'article' | 'website';
  /** Adds the schema.org Person JSON-LD (home pages). */
  person?: boolean;
  /** 404 and other pages that must not be indexed. */
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title,
  description = t('meta.description'),
  type = 'website',
  person = false,
  noindex = false,
} = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const links = site && !noindex ? alternates(Astro.url.pathname, site) : [];
const ogImage = site ? new URL(SITE.ogImage, site).href : SITE.ogImage;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
const ogAlternate = lang === 'fr' ? 'en_US' : 'fr_FR';
const jsonLd =
  person && canonical ? JSON.stringify(personJsonLd(canonical, t('site.role'))) : undefined;
const terminalProjects = sortProjects(
  await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`)),
).map((project) => ({
  title: project.data.title,
  href: projectPath(lang, parseProjectId(project.id).slug),
}));
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <!-- Applies the saved (or system) theme before first paint; re-applied after page swaps. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {
            /* storage blocked: fall back to the system preference */
          }
          if (theme !== 'light' && theme !== 'dark') {
            theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = theme;
          // Motion hidden states (see global.css) only when animations are allowed.
          document.documentElement.classList.toggle(
            'motion',
            !matchMedia('(prefers-reduced-motion: reduce)').matches,
          );
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-atkinson" />
    <Font cssVariable="--font-jetbrains" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#05060f" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} · ${t('site.role')}`} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {links.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <title>{pageTitle(title)}</title>
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-surface px-4 py-2 font-mono text-sm text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('skip.link')}
    </a>
    <!-- Decorative 3D background, loaded on first intent, kept across page swaps. -->
    <div id="space" transition:persist="space" aria-hidden="true" class="space-layer">
      <SpaceScene client:intent />
    </div>
    <slot />
    <footer class="mx-auto max-w-6xl px-4 pt-8 pb-12 font-mono text-xs text-muted">
      <p>
        © {new Date().getFullYear()} {SITE.name} ·{t('footer.credits')} :
        <a
          href="https://www.solarsystemscope.com/textures/"
          class="underline underline-offset-2 hover:text-ink"
        >
          Solar System Scope
        </a>
        (
        <a
          href="https://creativecommons.org/licenses/by/4.0/"
          class="underline underline-offset-2 hover:text-ink"
        >
          CC BY 4.0
        </a>
        )
      </p>
    </footer>
    <!-- Achievement toasts: one persistent polite live region. -->
    <div
      id="toasts"
      transition:persist="toasts"
      role="status"
      aria-live="polite"
      class="toasts"
    ></div>
    <Terminal client:event="orbite:terminal" lang={lang} projects={terminalProjects} />
    <script>
      import { initMotion } from '../scripts/motion';
      import { initShortcuts } from '../scripts/shortcuts';
      import { initAnchors } from '../scripts/anchors';
      import { initSound } from '../scripts/sound';

      initMotion();
      initShortcuts();
      initAnchors();
      initSound();
      // The game layer is not needed for the first paint: load it when the browser is idle.
      const idle = (task: () => void) =>
        'requestIdleCallback' in window
          ? requestIdleCallback(task, { timeout: 2000 })
          : setTimeout(task, 200);
      idle(() => void import('../scripts/game').then(({ initGame }) => initGame()));
    </script>
  </body>
</html>
