---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { pageTitle } from '../lib/site';
import SpaceScene from '../components/space/SpaceScene';
import Terminal from '../components/terminal/Terminal';
import { getCollection } from 'astro:content';
import { parseProjectId, projectPath, sortProjects } from '../lib/projects';
import { alternates, getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('meta.description') } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const links = site ? alternates(Astro.url.pathname, site) : [];
const terminalProjects = sortProjects(
  await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`)),
).map((project) => ({
  title: project.data.title,
  href: projectPath(lang, parseProjectId(project.id).slug),
}));
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <!-- Applies the saved (or system) theme before first paint; re-applied after page swaps. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {
            /* storage blocked: fall back to the system preference */
          }
          if (theme !== 'light' && theme !== 'dark') {
            theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = theme;
          // Motion hidden states (see global.css) only when animations are allowed.
          document.documentElement.classList.toggle(
            'motion',
            !matchMedia('(prefers-reduced-motion: reduce)').matches,
          );
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-atkinson" />
    <Font cssVariable="--font-jetbrains" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {canonical && <link rel="canonical" href={canonical} />}
    {links.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <title>{pageTitle(title)}</title>
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-surface px-4 py-2 font-mono text-sm text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('skip.link')}
    </a>
    <!-- Decorative 3D background, loaded on first intent, kept across page swaps. -->
    <div id="space" transition:persist="space" aria-hidden="true" class="space-layer">
      <SpaceScene client:intent />
    </div>
    <slot />
    <!-- Achievement toasts: one persistent polite live region. -->
    <div
      id="toasts"
      transition:persist="toasts"
      role="status"
      aria-live="polite"
      class="toasts"
    ></div>
    <Terminal client:event="orbite:terminal" lang={lang} projects={terminalProjects} />
    <script>
      import { initMotion } from '../scripts/motion';
      import { initGame } from '../scripts/game';

      initMotion();
      initGame();
    </script>
  </body>
</html>
